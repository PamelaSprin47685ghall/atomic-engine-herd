# Build trees. Never tracked: they are regenerated by cmake, and a checked-in tree
# shadows the source it was compiled from.
/build/
/build-asan/
/build-*/

# CMake leaves these beside an out-of-tree build too.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake

# Python test caches (modules/batch-compose/tests, tools).
__pycache__/
*.py[cod]
.pytest_cache/

# Test and run output.
*.log
